# ─────────────────────────────────────────────────────────────────────────────
# SourceMark — copy to .env and fill in.
#   cp .env.example .env && npm run dev
# The service starts without a Graph key, but every read will REFUSE.
# That is deliberate: mocked or static data is an explicit disqualifier.
# ─────────────────────────────────────────────────────────────────────────────

PORT=8787
LOG_LEVEL=info

# ── The Graph ────────────────────────────────────────────────────────────────
# Get a key at https://thegraph.com/studio  →  API Keys
GRAPH_API_KEY=
GRAPH_GATEWAY=https://gateway.thegraph.com

# ── Freshness policy defaults (a family may tighten these, never loosen) ─────
MAX_BLOCK_LAG=50
MAX_AGE_SECONDS=600
MIN_SOURCES=2

# ── Chain head anchoring ─────────────────────────────────────────────────────
# rpc      = compare indexed block against true chain head (preferred)
# relative = compare sources against best-indexed peer (weaker; documented)
ANCHOR_MODE=rpc
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com

# ── Payments (x402 on Hedera via the Blocky402 facilitator) ──────────────────
# x402 = live paywall     free = paywall disabled (read layer still refuses honestly)
PAYMENT_MODE=x402
X402_FACILITATOR=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
# Hedera account that receives payment, e.g. 0.0.1234567
X402_PAY_TO=
# HBAR = 0.0.0 ; an HTS token id also works
X402_ASSET=0.0.0
# Price per query, in tinybars. 100000 tinybar = 0.001 HBAR
X402_PRICE=100000
X402_TIMEOUT_SECONDS=300

# ── Receipt signing (EIP-191). Any 32-byte hex key; NOT a funded account. ────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECEIPT_SIGNING_KEY=

# ── Payout split ─────────────────────────────────────────────────────────────
# ledger = local append-only ledger    onchain = SourcePayouts.sol
SPLIT_MODE=ledger
ROUTING_FEE_BPS=1000
HOLDBACK_BPS=2000
HOLDBACK_VESTING_SECONDS=604800

# ── Onchain split (SPLIT_MODE=onchain only) ─────────────────────────────────
# Deploy and register every source in one step:
#   npm run payouts:deploy
# then paste the printed address here. Inspect live state with:
#   npm run payouts:status
SOURCE_PAYOUTS_ADDRESS=
HEDERA_JSON_RPC=https://testnet.hashio.io/api

# Deploys the contract AND signs recordRead() from the gateway. ECDSA hex key
# of the account that should collect the routing fee — normally the same
# account as X402_PAY_TO, since that is who receives read revenue.
# The contract limits this key to crediting sources: it cannot withdraw the
# fee or rule on disputes. Rotate it with setRecorder() if it leaks.
OPERATOR_PRIVATE_KEY=

# Who rules on disputes. Defaults to the operator, which means one key both
# takes the fee and decides refunds — fine for a solo testnet run, not a
# credible separation. Set this to a different address for anything real.
ARBITER_ADDRESS=

# Bond required to open a dispute, in tinybar. The only thing making a
# frivolous dispute expensive, since opening one freezes the named sources'
# holdback until it is resolved.
DISPUTE_BOND_TINYBAR=100000000

# ── Demo buyer (used by /demo/run, npm run pay, npm run agent) ───────────────
# Hedera account id + ECDSA private key of the PAYING account
BUYER_ACCOUNT_ID=
BUYER_PRIVATE_KEY=

# Shared secret the resale gateway (Bazantic) forwards as x-api-key or a
# bearer token, standing in for an x402 payment it settled on its own rail.
# Unset disables the resale channel; it fails closed.
RESALE_API_KEY=
# Name shown in responses and receipts for reads arriving that way.
RESALE_LABEL=bazantic
